# ===== LLM =====
# 供应商/模型（分级路由：mini 用于 Router/简单问答，flagship 用于 Specialist/质控）
LLM_PROVIDER=openai
LLM_MODEL_MINI=gpt-4o-mini
LLM_MODEL_FLAGSHIP=gpt-4o
LLM_API_KEY=sk-xxxxxxxx

# ===== 持久化 =====
DATABASE_URL=postgresql://care:care@localhost:5432/care_lifeline
QDRANT_URL=http://localhost:6333

# ===== 质控 =====
# LLM 语义评审风险阈值（经校准流程确定，见 docs/system-design.md §9.4）
QC_RISK_THRESHOLD=0.75

# ===== 运行时 =====
LOG_LEVEL=INFO
API_PORT=8000
# 预算护栏（防成本失控）
MAX_TOKENS_PER_SESSION=30000
MAX_SESSIONS_PER_USER_PER_DAY=50
