# ===== LLM（OpenAI 兼容协议）=====
# CARE_LLM_MODE=mock 时整套链路零外部 API 可跑（演示/CI 默认值）
CARE_LLM_MODE=mock
# 切换真实模型：把 LLM_MODE 改为 real，并填真实 Key（占位示例 sk-......）
# 火山方舟 Doubao（默认）与 DeepSeek 均兼容 OpenAI 协议，仅改下面三项即可：
CARE_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
CARE_LLM_API_KEY=sk-......
CARE_LLM_MODEL=doubao-seed-1-6-250615
CARE_LLM_MODEL_MINI=doubao-seed-1-6-250615
# 若用 DeepSeek：取消下一行注释并注释上面的 BASE_URL/MODEL
# CARE_LLM_BASE_URL=https://api.deepseek.com
# CARE_LLM_MODEL=deepseek-chat
# CARE_LLM_MODEL_MINI=deepseek-chat

# ===== 持久化 =====
# 默认 SQLite 兜底（无需任何外部依赖即可运行）；生产可切 PostgreSQL
CARE_DATABASE_URL=sqlite+aiosqlite:///./care.db
# CARE_DATABASE_URL=postgresql+psycopg://care:care@localhost:5432/care

# ===== RAG 指南检索 =====
# 默认关闭（零依赖内存向量库）。配置 QDRANT_URL 后启用 Qdrant；
# CARE_RAG_ENABLED=true 时启用本地 sentence-transformers 真实向量化（其余场景用确定性 mock 向量）。
CARE_QDRANT_URL=
CARE_QDRANT_API_KEY=
CARE_RAG_COLLECTION=care_guidelines
CARE_RAG_ENABLED=false

# ===== 外部药物相互作用（openFDA）=====
# 默认关闭：drug_interaction 工具只查本地 DDI 表。
# 开启后合并 openFDA 药品标签的实时相互作用记录；查询失败/超时自动降级回本地表。
# CARE_EXTERNAL_DDI_ENABLED=true
CARE_OPENFDA_BASE_URL=https://api.fda.gov
CARE_OPENFDA_TIMEOUT_SECONDS=3

# ===== 数据飞轮 =====
# workbench 审核定稿自动沉淀的评测反馈集路径（测试环境会重定向到临时目录）
CARE_FEEDBACK_DATA_PATH=data/eval/feedback_cases.json

# ===== 主动触发调度 =====
# 后台定时扫描患者指标、生成复诊提醒的间隔（秒）；启动时也会先跑一次。
CARE_PROACTIVE_INTERVAL_SECONDS=300
# 调度互斥锁：file（单机默认）| redis（多主机部署；需自行安装 redis 包）
CARE_PROACTIVE_LOCK_BACKEND=file
CARE_REDIS_URL=redis://localhost:6379/0
# 记忆保鲜：在用药物/过敏记录超过该天数未复核则生成复核提醒（0 = 关闭）
CARE_MEMORY_REVIEW_DAYS=180

# ===== 成本护栏 =====
# 单会话 token 预算：会话累计达到该值后拒绝新请求（0 = 不限额）
CARE_SESSION_TOKEN_BUDGET=0

# ===== 运行环境 =====
# dev（默认）不校验 JWT 密钥强度；production 下携带开发默认密钥将拒绝启动
CARE_ENV=dev

# ===== 鉴权 =====
# 必须修改；生产环境务必通过环境变量注入强随机值
CARE_JWT_SECRET=dev-insecure-secret-change-me-please-rotate-in-prod
CARE_JWT_ALGORITHM=HS256
CARE_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ===== 质控 =====
# LLM 语义评审风险阈值（经校准流程确定，见 docs/system-design.md §9.4）
CARE_QC_RISK_THRESHOLD=0.75

# ===== 运行时 =====
LOG_LEVEL=INFO
CARE_API_PORT=8000
