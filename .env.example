# ===== LLM（OpenAI 兼容协议）=====
# LLM_MODE=mock 时整套链路零外部 API 可跑（演示/CI 默认值）
LLM_MODE=mock
# 切换真实模型：把 LLM_MODE 改为 real，并填真实 Key（占位示例 sk-......）
# 火山方舟 Doubao（默认）与 DeepSeek 均兼容 OpenAI 协议，仅改下面三项即可：
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=sk-......
LLM_MODEL=doubao-seed-1-6-250615
LLM_MODEL_MINI=doubao-seed-1-6-250615
# 若用 DeepSeek：取消下一行注释并注释上面的 BASE_URL/MODEL
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# LLM_MODEL_MINI=deepseek-chat

# ===== 持久化 =====
# 默认 SQLite 兜底（无需任何外部依赖即可运行）；生产可切 PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./care.db
# DATABASE_URL=postgresql+psycopg://care:care@localhost:5432/care

# ===== RAG 指南检索 =====
# 默认关闭（零依赖内存向量库）。配置 QDRANT_URL 后启用 Qdrant；
# RAG_ENABLED=true 时启用本地 sentence-transformers 真实向量化（其余场景用确定性 mock 向量）。
QDRANT_URL=
QDRANT_API_KEY=
RAG_COLLECTION=care_guidelines
RAG_ENABLED=false

# ===== 主动触发调度 =====
# 后台定时扫描患者指标、生成复诊提醒的间隔（秒）；启动时也会先跑一次。
PROACTIVE_INTERVAL_SECONDS=300

# ===== 鉴权 =====
# 必须修改；生产环境务必通过环境变量注入强随机值
JWT_SECRET=dev-insecure-secret-change-me-please-rotate-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ===== 质控 =====
# LLM 语义评审风险阈值（经校准流程确定，见 docs/system-design.md §9.4）
QC_RISK_THRESHOLD=0.75

# ===== 运行时 =====
LOG_LEVEL=INFO
API_PORT=8000
