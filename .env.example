# ===== LLM =====
# 供应商/模型（分级路由：mini 用于 Router/简单问答，flagship 用于 Specialist/质控）
# LLM_MODE=mock 时整套链路零外部 API 可跑（演示/CI 默认值）
LLM_MODE=mock
LLM_PROVIDER=openai
LLM_MODEL_MINI=gpt-4o-mini
LLM_MODEL_FLAGSHIP=gpt-4o
LLM_API_KEY=sk-xxxxxxxx

# ===== 持久化 =====
# 默认 SQLite 兜底（无需任何外部依赖即可运行）；生产可切 PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./care.db
# DATABASE_URL=postgresql+psycopg://care:care@localhost:5432/care
QDRANT_URL=http://localhost:6333

# ===== 鉴权 =====
# 必须修改；生产环境务必通过环境变量注入强随机值
JWT_SECRET=dev-insecure-secret-change-me-please-rotate-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ===== 质控 =====
# LLM 语义评审风险阈值（经校准流程确定，见 docs/system-design.md §9.4）
QC_RISK_THRESHOLD=0.75

# ===== 运行时 =====
LOG_LEVEL=INFO
API_PORT=8000
# 预算护栏（防成本失控）
MAX_TOKENS_PER_SESSION=30000
MAX_SESSIONS_PER_USER_PER_DAY=50
